// Syncthing per-device ignore list. This .stignore is itself not synced,
// so entries here keep files local to THIS machine only.

// Machine-local config — must NOT propagate to other devices. Mirrors the
// "machine-specific configs" section of .gitignore.
*.local.sh
*.local.zsh
homebrew/Brewfile.common.local
homebrew/Brewfile.macos.local

// TeleClaude per-machine state: each machine keeps its own declaration, lock and
// runtime database at its own TeleClaude version.
/teleclaude.yml
/teleclaude.yml.lock
/.teleclaude

// Git history is not synced: git's database is not safe to copy file by file.
/.git
