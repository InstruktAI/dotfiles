# Syncthing metadata
.stfolder/
.stversions/
*.sync-conflict-*

# macOS metadata
.DS_Store

# Machine-specific configs (synced via Syncthing, not git)
*.local.zsh
*.local.sh
homebrew/Brewfile.local
.env

# History/backup files and folders
.history/
.zsh_history

# Editor/runtime backups
*.bak
*.tmp

# Python bytecode
__pycache__/

# Appearance runtime logs and sync-conflict copies
appearance/agent_state.json
appearance/bin/*.log
appearance/bin/*.log.*
appearance/bin/*.sync-conflict-*

.teleclaude/
