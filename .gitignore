# Syncthing metadata
.stfolder/
.stversions/

# Machine-specific configs (synced via Syncthing, not git)
*.local.zsh
*.local.sh
.env

# History/backup folders
.history/

# Python bytecode
__pycache__/

# Appearance runtime logs and sync-conflict copies
terminal/bin/*.log
terminal/bin/*.log.*
terminal/bin/*.sync-conflict-*

.teleclaude/
