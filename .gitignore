# Syncthing metadata
.stfolder/
.stversions/
*.sync-conflict-*
.stignore

# macOS metadata
.DS_Store

# Machine-specific configs (synced via Syncthing, not git)
*.local.zsh
*.local.sh
macos/Brewfile.local
.env

# History/backup files and folders
.history/
.zsh_history

# Editor/runtime backups
*.bak
*.tmp

# Python bytecode
__pycache__/

# Appearance runtime logs and sync-conflict copies
terminal/agent_state.json
terminal/bin/*.log
terminal/bin/*.log.*
terminal/bin/*.sync-conflict-*

.teleclaude/
