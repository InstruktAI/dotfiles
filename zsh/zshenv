# Symlinked to ~/.zshenv by install.sh.
#
# .zshenv is the ONLY zsh init file sourced for non-interactive, non-login
# shells — e.g. `ssh host '<cmd>'` and scripts. The interactive PATH built in
# 10-path.zsh is otherwise unavailable there, which breaks tools invoked over
# ssh (notably cross-computer tmux attach, which runs bare `tmux` on the peer).
#
# Keep this minimal and non-interactive-safe: PATH only, no compinit, no prompt.
# Interactive shells re-run these via .zshrc -> init.zsh; append_path uses
# `typeset -U path`, so re-sourcing is idempotent.

export ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"

[[ -r "$ZDOTDIR/00-helpers.zsh" ]] && source "$ZDOTDIR/00-helpers.zsh"
[[ -r "$ZDOTDIR/10-path.zsh" ]] && source "$ZDOTDIR/10-path.zsh"

# Rust toolchain (defines cargo env; also adds ~/.cargo/bin)
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
