# Copy to .env and run ./install.sh to render these values into launchd.
# Shell environment variables passed to ./install.sh override .env values.

# Amsterdam defaults.
APPEARANCE_LATITUDE=52.37
APPEARANCE_LONGITUDE=4.89

# Always start dark mode this many minutes before sunset.
APPEARANCE_DARK_OFFSET_MINUTES=0

# Extra early-dark correction while local daylight saving time is active.
APPEARANCE_DST_DARK_OFFSET_MINUTES=60
