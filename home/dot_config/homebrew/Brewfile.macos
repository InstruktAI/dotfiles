# Dotfiles Brewfile - macOS-only tools for every Mac, server or workstation: GNU
# userland overrides, the terminal, and OS-integration formulae that don't
# build or don't make sense on Linux. Apps only a workstation needs live in
# Brewfile.workstation.
# Deployed by chezmoi to ~/.config/homebrew on macOS only.

# --- GNU userland (macOS ships BSD variants; Linux already has these natively) ---
brew "coreutils"
brew "findutils"
brew "gnu-sed"
brew "gnu-tar"
brew "grep"

# --- Shell & Terminal (macOS-specific integration) ---
brew "reattach-to-user-namespace"

# --- Security & Encryption (macOS Keychain integration) ---
brew "pinentry-mac"


# --- Casks ---
cask "iterm2"
