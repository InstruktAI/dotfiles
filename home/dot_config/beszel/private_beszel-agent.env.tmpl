# Beszel agent environment, sourced by Homebrew's beszel-agent-launcher.
# Rendered by chezmoi from its data (beszel.*); change the source or this
# machine's chezmoi data, not this file.
KEY={{ .beszel.key | quote }}
LISTEN={{ .beszel.listen | quote }}
{{- if .beszel.hub_url }}
HUB_URL={{ .beszel.hub_url | quote }}
{{- end }}
{{- if includeTemplate "beszel-token-deployed" . }}
TOKEN_FILE={{ joinPath .chezmoi.homeDir ".config/beszel/token" | quote }}
{{- end }}
