{{- /*
  Generates ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.

  Age encryption is always configured, so chezmoi can read the encrypted files
  in the source on every machine. The identity is ~/.config/chezmoi/key.txt;
  until a machine holds it, .chezmoiignore skips the encrypted targets. The
  recipient (needed only to encrypt, `chezmoi add --encrypt`) is read from the
  "# public key:" line that age-keygen writes into the identity file.

  Machine-local data (everything under [data]) is carried over verbatim each
  time this template is regenerated, so `chezmoi init` never drops it.
*/ -}}
{{- $identity := joinPath .chezmoi.homeDir ".config/chezmoi/key.txt" -}}
{{- $recipient := "" -}}
{{- if stat $identity -}}
{{-   $recipient = include $identity | regexFind "age1[0-9a-z]+" -}}
{{-   if not $recipient -}}
{{-     fail (printf "%s has no \"# public key: age1...\" line; recreate it with age-keygen" $identity) -}}
{{-   end -}}
{{- end -}}
encryption = "age"

[age]
    identity = {{ $identity | quote }}
{{- if $recipient }}
    recipient = {{ $recipient | quote }}
{{- end }}

[diff]
    exclude = ["scripts"]
{{- $data := omit . "chezmoi" }}
{{- if $data }}

{{ dict "data" $data | toToml }}
{{- end }}
