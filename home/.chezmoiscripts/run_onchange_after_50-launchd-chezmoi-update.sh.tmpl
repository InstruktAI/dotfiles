{{ template "launchd-reload" dict "label" "ai.instrukt.chezmoi-update" "hash" (includeTemplate "Library/LaunchAgents/ai.instrukt.chezmoi-update.plist.tmpl" . | sha256sum) }}
{{ end -}}
