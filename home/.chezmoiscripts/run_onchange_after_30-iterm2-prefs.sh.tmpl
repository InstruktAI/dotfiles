{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Points iTerm2 at the preferences folder in the dotfiles working tree, so the
# preferences iTerm2 saves land in the git source.
set -euo pipefail
folder={{ joinPath .chezmoi.workingTree "iterm2" | quote }}
defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$folder"
defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
echo "[iterm2] preferences folder: $folder"
{{ end -}}
